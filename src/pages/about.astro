import BaseLayout from '../layouts/BaseLayout.astro'; import { site } from '../config/site';
---
<BaseLayout title="关于 CNplus"><h1>关于 CNplus</h1><p>CNplus 是用中文表达程序的编程语言项目。项目始于 2021 年，并在 2026 年重启。</p><p>它拥有自己的 lexer、parser 与 AST，采用可插拔后端；当前后端将代码转译为 Python。</p><p>项目采用 Apache-2.0 许可证。</p><a href={site.links.github}>查看源代码</a></BaseLayout>
