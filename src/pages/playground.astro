---
// CNplus 在线运行器（playground）—— 阶段 4 T11
// Pyodide（浏览器里的 Python）加载 cnplus wheel —— 复用同一前端，
// 零重复实现。纯静态站，无后端服务。
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/playground.css';

const 示例代码 = `# 改改看，点「运行」
类 学生
    初始化(名字, 分数)
        如果 分数 < 0 或 分数 > 100
            抛出 "分数要在 0 到 100 之间"
    函数 等级()
        如果 自己.分数 >= 90
            返回 "优秀"
        否则 如果 自己.分数 >= 60
            返回 "及格"
        否则
            返回 "不及格"
    函数 名片()
        返回 @"{自己.名字}：{自己.分数} 分（{自己.等级()}）"

设 三班 = [学生("小明", 92), 学生("小红", 85), 学生("小刚", 58)]
遍历 三班 每个 一名
    打印(一名.名片())

设 总分 = 0
遍历 三班 每个 一名
    总分 = 总分 + 一名.分数
打印(@"平均：{总分 / 长度(三班)} 分")`;
---

<BaseLayout title="在线运行 | CNplus">
  <script src="https://cdn.jsdelivr.net/pyodide/v0.26.2/full/pyodide.js"></script>
  <main class="playground">
    <section class="hero">
      <h1>在线运行 CNplus</h1>
      <p>不装任何东西——改改下面的代码，点「运行」。</p>
    </section>

    <div class="editor-wrap">
      <div class="toolbar">
        <button id="run" class="btn primary">▶ 运行</button>
        <button id="share" class="btn">复制分享链接</button>
        <button id="reset" class="btn">重置示例</button>
        <span id="status" class="status">首次运行需加载运行环境（约 10 秒，之后有缓存）</span>
      </div>
      <div class="panes">
        <textarea id="code" spellcheck="false" autocomplete="off"
          aria-label="CNplus 代码编辑区" data-default-code={示例代码}></textarea>
        <pre id="output" aria-label="运行输出"><span class="hint">输出会出现在这里</span></pre>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      const 代码框 = document.getElementById('code');
      const 输出框 = document.getElementById('output');
      const 运行钮 = document.getElementById('run');
      const 分享钮 = document.getElementById('share');
      const 重置钮 = document.getElementById('reset');
      const 状态 = document.getElementById('status');
      const 默认代码 = 代码框.dataset.defaultCode || '';

      // URL hash 分享：#code=base64
      try {
        const m = location.hash.match(/^#code=(.+)$/);
        if (m) 代码框.value = decodeURIComponent(escape(atob(decodeURIComponent(m[1]))));
        else 代码框.value = 默认代码;
      } catch (e) { 代码框.value = 默认代码; }

      分享钮.addEventListener('click', () => {
        const b = btoa(unescape(encodeURIComponent(代码框.value)));
        const url = location.origin + location.pathname + '#code=' + b;
        navigator.clipboard.writeText(url).then(
          () => { 状态.textContent = '分享链接已复制 ✓'; },
          () => { 状态.textContent = '复制失败——请手动复制地址栏'; });
      });
      重置钮.addEventListener('click', () => { 代码框.value = 默认代码; });

      async function 运行() {
        运行钮.disabled = true;
        输出框.textContent = '';
        try {
          if (!window._cnplusPy) {
            if (!window.loadPyodide) throw new Error('运行环境脚本未加载，请检查网络后刷新');
            状态.textContent = '加载运行环境…（首次约 10 秒，之后有缓存）';
            const py = await window.loadPyodide();
            await py.loadPackage('micropip');
            状态.textContent = '安装 CNplus…';
            await py.runPythonAsync(
              'import micropip; await micropip.install("/pyodide/cnplus-1.0.0-py3-none-any.whl")');
            window._cnplusPy = py;
          }
          const py = window._cnplusPy;
          py.globals.set('_cnp_code', 代码框.value);
          状态.textContent = '运行中…';
          const 结果 = py.runPython(`
from cnplus.source import 源文件
from cnplus.parser.parser import 解析
from cnplus.checker import 检查
from cnplus.backends.treewalk import 树遍历后端
_源 = 源文件(_cnp_code, '<playground>')
_程, _袋 = 解析(_源)
if _袋.有错:
    _文本 = _袋.渲染全部(_源)
else:
    检查(_程, _袋)
    if _袋.有错:
        _文本 = _袋.渲染全部(_源)
    else:
        _行 = []
        _后端 = 树遍历后端(输出=_行.append)
        _后端.执行(_程, _源, _袋)
        _文本 = chr(10).join(_行) if _行 else ''
        if _袋.有错:
            _文本 = _袋.渲染全部(_源) + _文本
_文本
`);
          输出框.textContent = 结果 || '（没有输出）';
          状态.textContent = '完成 ✓';
        } catch (e) {
          输出框.textContent = '出错了：' + e.message;
          状态.textContent = '';
        } finally {
          运行钮.disabled = false;
        }
      }
      运行钮.addEventListener('click', 运行);
    })();
  </script>
</BaseLayout>
